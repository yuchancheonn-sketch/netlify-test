rules_version = '2';

/*
 * 애기애타 10기 앱 Firestore 보안 규칙
 * ------------------------------------------------------------------
 * 한 줄 요약: 막히지 않은(status: approved) 원우는 수첩·일정·사진을 서로 열어 보고,
 * 1:1 채팅만 두 사람에게 잠겨 있습니다.
 *
 * ★★ 들어오는 문은 지금 열려 있습니다 ★★
 * 초대 코드도 운영진 승인도 쓰지 않기로 했으므로, Google 계정으로 로그인한 사람은
 * 누구나 들어옵니다. **주소를 아는 사람은 원우 휴대폰 번호까지 볼 수 있다**는 뜻입니다.
 * 이건 규칙의 실수가 아니라 고른 결과입니다. 문을 세우고 싶어지면 초대 코드
 * (README "초대 코드를 다시 켜고 싶다면")나 승인 절차를 되살리면 됩니다.
 *
 * 대신 **문 안쪽은 잠가 두었습니다.** 이 두 가지가 핵심입니다.
 *  1) 자기 손으로 운영진이 될 수 없습니다 — role/status는 운영진만 바꿉니다.
 *  2) 운영진이 "차단"한 사람은 **진짜로** 아무것도 못 봅니다 — 화면이 아니라
 *     규칙이 status를 보기 때문입니다(isMember). 예전에는 화면만 막혀 있어서,
 *     차단당한 사람이 Firestore를 직접 부르면 그대로 다 내려왔습니다.
 *
 * 규칙은 "하나라도 허용하면 허용"입니다. match /{document=**} 같은 전체 허용 줄을
 * 남겨두면 아래를 아무리 잠가도 그 줄이 통째로 통과시킵니다. 그래서 컬렉션을
 * 하나씩 적었습니다. 새 컬렉션을 만들면 여기에 직접 추가해야 하고, 안 적으면 막힙니다.
 *
 * 배포:  Firebase 콘솔 → Firestore → 규칙 탭에 이 파일 전체를 붙여넣고 "게시"
 *        또는  firebase deploy --only firestore:rules
 *
 * ★ 이 파일을 고치는 것만으로는 아무것도 바뀌지 않습니다.
 *   반드시 콘솔에 올려야(게시해야) 실제로 적용됩니다.
 *   rules_version 줄부터 맨 아래 중괄호까지 전부 붙여넣어야 합니다.
 *   일부만 붙여넣으면 mismatched input 'match' 오류가 납니다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /** 내 계정 문서 자리. 아래 두 함수가 같은 곳을 봅니다. */
    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    /*
     * 막히지 않은 원우인가. (운영진이 "차단"을 누르면 status가 pending이 됩니다)
     *
     * 규칙 안에서 문서를 한 번 읽습니다(get). 읽기 요금이 붙지만 한 요청 안에서는
     * 캐시되어 한 번만 세고, 하루 5만 읽기 무료 한도에 견주면 무시할 만합니다.
     * 차단이 말뿐이 아니라 실제로 걸리게 하는 값으로는 훨씬 쌉니다.
     */
    function isMember() {
      return isSignedIn()
             && exists(myUserPath())
             && get(myUserPath()).data.status == 'approved';
    }

    /** 운영진(천유찬)인가. 승인·권한 변경만 여기서 가릅니다. */
    function isAdmin() {
      return isSignedIn()
             && exists(myUserPath())
             && get(myUserPath()).data.role == 'admin';
    }

    /*
     * 이 대화방에 낄 수 있는 사람인지.
     *
     * 방 문서를 따로 읽지 않고 방 id만 보고 판단합니다.
     * 1:1 방 id는 두 사람의 uid를 정렬해 "__"로 이어 붙인 것이라
     * (예: abc123__xyz789) id 안에 이미 참여자가 들어 있습니다.
     * 문서를 읽어 확인하면 규칙을 따질 때마다 읽기 요금이 붙습니다.
     *
     * 예전에는 roomId == 'main'(단체방)도 통과시켰습니다. 2026-09-10에
     * 단체방을 없애면서 그 줄을 지웠고, 이제 남은 단체방의 메시지는
     * 아무도 열지도 쓰지도 못합니다.
     */
    function isRoomMember(roomId) {
      // 2026-10-06 (보안 점검 후 수정): 방 id는 반드시 uid 두 개(a__b). 내 uid 하나만이거나 셋 이상인 모양은 받지 않습니다.
      return roomId.split('__').size() == 2 && request.auth.uid in roomId.split('__');
    }

    /*
     * 대화방 문서의 모양 확인 (2026-10-06 보안 점검 후 수정) — 1:1 방은 memberUids가 방 id의 두 uid와 같아야 하고,
     * 단체방은 memberUids 없이 cohort가 방 id의 기수여야 합니다. 칸이 없으면(기본값) 통과 — 낡은 방 문서 배려.
     */
    function chatRoomShapeOk(roomId) {
      return isCohortRoom(roomId)
             ? (!request.resource.data.keys().hasAny(['memberUids'])
                && request.resource.data.get('cohort', roomId.split('-')[1] + '기') == roomId.split('-')[1] + '기')
             : request.resource.data.get('memberUids', roomId.split('__')).toSet() == roomId.split('__').toSet();
    }

    /*
     * ── 기수 단체방 (2026-09-22) ──
     *
     * 방 id는 "cohort-10" 꼴이고, 그 기수 원우는 **무조건** 이 방에 듭니다.
     * 명단(memberUids)을 방 문서에 적지 않습니다 — 적어 두면 가입·승인·기수 변경마다
     * 배열을 고쳐야 하고 한 번만 빠뜨려도 누군가는 방에서 사라집니다.
     * 대신 내 users 문서의 cohort와 방 id를 견줍니다. 적어 두는 곳이 없으니 어긋날 수가 없습니다.
     *
     * ★ get(myUserPath())는 여기서 공짜입니다.
     *   isMember()가 같은 요청에서 이미 같은 문서를 읽었고, 한 번의 규칙 판정 안에서
     *   같은 경로의 get은 캐시되어 읽기가 한 번만 물립니다.
     *
     * ★ 기수 칸이 없는 옛 문서는 10기로 봅니다 — lib/cohort.ts의 cohortOf와 같은 규칙입니다.
     *   앱과 규칙이 다르게 보면 화면에는 보이는데 규칙이 막는 일이 생깁니다.
     *
     * ★ 운영진은 다른 기수 방도 봅니다. 홈·자료·수업 화면에서 기수를 바꿔 보는 것과 같은 기준입니다.
     *
     * ★ 방 id 모양을 바꾸면 lib/chat-room-id.ts의 COHORT_ROOM_PREFIX도 같이 고쳐야 합니다.
     */
    function isCohortRoom(roomId) {
      return roomId.matches('^cohort-([1-9]|10)$');
    }

    function myCohort() {
      return get(myUserPath()).data.get('cohort', '10기');
    }

    function isCohortRoomMine(roomId) {
      return isCohortRoom(roomId)
             && (isAdmin() || myCohort() == roomId.split('-')[1] + '기');
    }

    /** 이 방을 열고 쓸 수 있는 사람인지 — 1:1 방이거나 내 기수 단체방이거나. */
    function canUseRoom(roomId) {
      return isRoomMember(roomId) || isCohortRoomMine(roomId);
    }

    /*
     * ── 무기명 투표의 표 수 확인 (2026-09-11) ──
     * 고를 것은 2~4개라 반복문 없이 자리마다 적습니다(규칙에는 반복문이 없습니다).
     * 자리가 없는 칸은 앞의 size 조건에서 멈추므로 읽지 않습니다(&&·||는 앞이 정해지면 뒤를 안 봅니다).
     */
    function countAt(counts, index) {
      return counts.size() > index ? counts[index] : 0;
    }

    function countsAreInts(counts) {
      return counts.size() >= 2 && counts.size() <= 4
             && counts[0] is int && counts[1] is int
             && (counts.size() < 3 || counts[2] is int)
             && (counts.size() < 4 || counts[3] is int);
    }

    /** 새로 여는 투표의 표 수 — 모든 자리가 0 */
    function isAllZero(counts) {
      return countsAreInts(counts)
             && countAt(counts, 0) == 0 && countAt(counts, 1) == 0
             && countAt(counts, 2) == 0 && countAt(counts, 3) == 0;
    }

    /** 옛 표 수에서 딱 한 자리만 1 늘었는지 (줄어든 자리 없음, 합계 +1, 모두 정수) */
    function isOneVoteMore(before, after) {
      return countsAreInts(after)
             && after.size() == before.size()
             && countAt(after, 0) >= countAt(before, 0)
             && countAt(after, 1) >= countAt(before, 1)
             && countAt(after, 2) >= countAt(before, 2)
             && countAt(after, 3) >= countAt(before, 3)
             && countAt(after, 0) + countAt(after, 1) + countAt(after, 2) + countAt(after, 3)
                == countAt(before, 0) + countAt(before, 1) + countAt(before, 2) + countAt(before, 3) + 1;
    }

    /*
     * ── 계정 문서 ──
     *
     * 여기만 규칙이 깁니다. 앱의 문지기가 이 문서의 status 값이라,
     * 그 값을 자기 손으로 바꿀 수 있으면 문지기가 없는 것과 같기 때문입니다.
     */
    match /users/{uid} {
      /*
       * 차단당한 사람도 자기 문서 하나는 읽을 수 있어야 합니다.
       * 그래야 대기 화면이 뜨고, 운영진이 다시 풀어주는 순간 새로고침 없이 넘어갑니다.
       */
      allow get: if isSignedIn() && (request.auth.uid == uid || isMember());

      // 원우 목록 훑기는 막히지 않은 원우만.
      allow list: if isMember();

      /*
       * 처음 로그인한 사람이 자기 계정 문서를 만듭니다. 자기 자리에만,
       * **평원우 권한으로만** 만들 수 있습니다. role을 'admin'으로 적어 넣는
       * 가입은 여기서 거부됩니다 — 운영진은 운영진만 임명할 수 있습니다.
       *
       * status는 'approved'입니다. 승인 절차를 쓰지 않기로 했기 때문입니다.
       * (차단당한 사람이 문서를 지우고 다시 만드는 길은 없습니다 — 문서가
       *  이미 있으면 create가 아니라 update로 취급되고, delete는 아무도 못 합니다.)
       */
      /*
       * ★ 2026-10-06 사용자 요청 (보안 점검 후 수정): 만들 때 들어갈 수 있는 칸을 가입 화면(app/join/page.tsx)이
       *   적는 칸으로만 묶었습니다. 서버가 쓰는 칸(verifiedPhone 등)이나 엉뚱한 칸을 처음부터 심는 길을 막습니다.
       *   status 'approved'는 사용자 결정이라 그대로입니다(승인제 권장 — CLAUDE.md "보안 점검 후 수정").
       *   join 화면에 칸을 더하면 여기 목록에도 더해야 합니다(안 더하면 가입이 permission-denied).
       */
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'approved'
                    && request.resource.data.role == 'member'
                    && request.resource.data.keys().hasOnly([
                         'uid', 'email', 'name', 'photoURL', 'birthdayMonthDay', 'birthdayYear',
                         'memberType', 'company', 'position', 'phone', 'councilRole',
                         'introduction', 'introVideoUrl', 'role', 'status', 'cohort',
                         'inviteCode', 'profileCompleted', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.get('profileCompleted', false) == false
                    && request.resource.data.get('createdAt', request.time) == request.time;

      /*
       * 수첩은 원우 누구나 서로 채워줍니다 — 그건 그대로 둡니다.
       * 다만 권한(role)과 승인 상태(status)만은 운영진만 건드릴 수 있습니다.
       * 이 두 줄이 없으면 원우 아무나 자기를 운영진으로 올릴 수 있습니다.
       *
       * ★ 2026-10-06 사용자 요청 (보안 점검 후 수정): "남의 문서는 아무 칸이나"를 **허용 칸 목록**으로 좁혔습니다.
       *   예전에는 남의 users 문서의 phone까지 고칠 수 있었고, 계정 합치기(/api/account/link)가 그 phone을 믿어
       *   남의(운영진 포함) 계정의 로그인 표를 가져갈 수 있었습니다. 지금은
       *   - 운영진: 전부(예전과 같음).
       *   - 본인: role·status 말고도 uid·createdAt·서버가 적는 칸(verifiedPhone, verifiedPhoneAt)은 못 바꿈.
       *     (phone·email·cohort·photoURL은 본인 것이라 그대로 고칠 수 있음.)
       *   - 다른 원우: 수첩 칸(회사·직책·원우회 직위·소개 영상·구분)만 + 고친 사람 표시(updatedBy는 반드시 내 uid).
       *     이름·기수·휴대폰·이메일·사진·자기소개·생일은 본인이나 운영진만 고칩니다.
       *     (기수는 단체 채팅방 자격을 가르는 값이라 남이 옮기면 안 됩니다.)
       *   MemberEditSheet가 남의 가입 계정을 고칠 때 이름·기수·휴대폰 칸을 잠그고 보내지 않는 것도 이 규칙 때문입니다.
       */
      allow update: if isAdmin()
                    || (isMember()
                        && request.auth.uid == uid
                        && request.resource.data.get('role', 'member')
                             == resource.data.get('role', 'member')
                        && request.resource.data.get('status', 'pending')
                             == resource.data.get('status', 'pending')
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['uid', 'createdAt', 'verifiedPhone', 'verifiedPhoneAt', 'inviteCode']))
                    || (isMember()
                        && request.auth.uid != uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['memberType', 'company', 'position', 'councilRole',
                                       'introVideoUrl', 'updatedBy', 'updatedByName', 'updatedAt'])
                        && request.resource.data.get('updatedBy', '') == request.auth.uid);

      /*
       * 계정 삭제는 아무도 못 합니다. 지워도 다음 로그인에 다시 만들어질 뿐이고,
       * 막고 싶은 계정은 status를 'pending'으로 되돌리면 그것으로 잠깁니다.
       * 정말 지워야 하면 Firebase 콘솔에서 합니다.
       */
      allow delete: if false;
    }

    /*
     * ★ 로그인 없이 읽기 (2026-09-24 사용자 요청 "보는 것만큼 로그인 없이, 수정이나 올리기는 그때서야 로그인").
     *   아래 "allow read: if true" 자리들은 로그인 안 한 사람도 읽습니다 — 앱 주소를 아는 누구나입니다(검색엔진은 막음).
     *   쓰기는 모두 예전처럼 원우만. 원우 명단(users·roster — 연락처)·채팅·알림·기기 토큰은 열지 않았고,
     *   로그인 안 한 사람의 원우수첩은 서버가 번호·이메일을 뺀 명단을 내려줍니다(/api/public/directory).
     */
    // ── 원우끼리 함께 쓰는 것들 ──
    // 서로 수첩을 채워주고 명단을 정리하는 앱이라 이 안에서는 권한을 크게 나누지 않았습니다.
    // (2026-10-06 보안 점검 후: 아래 컬렉션마다 "누가 무엇을 고칠 수 있나"를 한 단계 좁혔습니다 — 각 자리 주석 참고.)

    /*
     * 사진·파일 주소는 이 앱의 Cloudinary 보관소(클라우드 이름 qz4f4bh5, apphosting.yaml의
     * NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME)의 https 주소만 받습니다 — 남의 서버 주소(추적 픽셀·피싱 이미지)를
     * 앨범·자료실에 걸어 두는 것을 막습니다. 클라우드 이름을 바꾸면 여기도 같이 고쳐야 합니다.
     * (2026-10-06 사용자 요청 (보안 점검 후 수정))
     */
    function isCloudinaryUrl(value) {
      return value is string && value.matches('^https://res[.]cloudinary[.]com/qz4f4bh5/.*');
    }

    /*
     * roster — 아직 가입하지 않은 원우의 수첩 칸 (2026-10-06 보안 점검 후 좁힘).
     *   읽기: 원우. 만들기: 원우 누구나(MemberEditSheet "원우 추가하기", 연결 안 된 칸 + 내가 만든 칸으로만).
     *   고치기: ① 수첩 내용 칸만(고친 사람 updatedBy는 내 uid) ② linkedUid는 **내 uid로 처음 이을 때만**
     *   (가입하면서 내 이름의 명단 칸에 잇는 lib/roster-link.ts). 남의 uid로 잇거나 이은 것을 바꾸는 일은 운영진만.
     *   지우기: 운영진만(예전엔 원우 누구나 명단을 지울 수 있었음 — 앱에는 지우는 화면이 운영진 화면뿐).
     */
    match /roster/{rosterId} {
      allow read: if isMember();
      allow create: if isAdmin()
                    || (isMember()
                        && request.resource.data.createdBy == request.auth.uid
                        && request.resource.data.get('linkedUid', null) == null
                        && request.resource.data.keys().hasOnly([
                             'name', 'cohort', 'memberType', 'linkedUid', 'note', 'createdBy', 'createdAt',
                             'company', 'position', 'phone', 'councilRole', 'bio', 'introVideoUrl',
                             'updatedBy', 'updatedByName', 'updatedAt']));
      allow update: if isAdmin()
                    || (isMember()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid'])
                        && resource.data.get('linkedUid', null) == null
                        && request.resource.data.get('linkedUid', null) == request.auth.uid)
                    || (isMember()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name', 'cohort', 'memberType', 'company', 'position', 'phone',
                                       'councilRole', 'bio', 'introVideoUrl',
                                       'updatedBy', 'updatedByName', 'updatedAt'])
                        && request.resource.data.get('updatedBy', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    /*
     * 모임 일정.
     *
     * 올리는 것은 원우 누구나(2026-09-11부터 — 그 전엔 화면에서 운영진만 보였습니다).
     * 번개 모임처럼 원우가 직접 여는 일정이 많아서입니다. 올릴 때 createdBy가 본인이어야
     * 합니다 — 새 일정 알림(/api/push/event)도 그 값으로 보낸 사람을 확인합니다.
     *
     * 고치는 것은 올린 사람과 운영진만. 남이 올린 일정이 조용히 바뀌면 원우들이 헷갈립니다.
     * createdBy는 고쳐서 넘겨받을 수 없게 묶습니다.
     *
     * ★ 지우는 것은 **그 기수 원우 누구나** (2026-09-25 사용자 "해당 기수 원우들이 자유롭게 일정 추가…
     *   지울려면 지울 수도"). 그 전엔 올린 사람과 운영진만이었습니다. 기수 칸이 없는 옛 일정은 10기로 봅니다.
     *   도산아카데미 일정(academyEvents)은 따로라 여기 규칙과 상관없이 앱에서 지울 수 없습니다.
     */
    match /events/{eventId} {
      allow read: if true;
      allow create: if isMember()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember()
                    && (resource.data.get('createdBy', '') == request.auth.uid || isAdmin())
                    && request.resource.data.get('createdBy', '')
                         == resource.data.get('createdBy', '');
      allow delete: if isMember()
                    && (resource.data.get('createdBy', '') == request.auth.uid
                        || isAdmin()
                        || resource.data.get('cohort', '10기') == myCohort());

      // rsvps(참석/불참/미정)는 2026-09-11에 "참석하시나요?"를 없애며 규칙에서도 뺐습니다.
    }

    /*
     * 도산아카데미 일정 (2026-09-23) — 서버가 dosan21.kr 새 글에서 읽어 적습니다(lib/academy-calendar-server.ts).
     * 모든 기수가 함께 보는 읽기 전용입니다. 앱에서는 쓰지 못합니다.
     * (폰 캘린더 구독 열쇠 calendarTokens는 서버만 쓰는 자리라 여기 적지 않습니다 — 앱에서 막힘.)
     */
    match /academyEvents/{eventId} {
      allow read: if true;
    }

    /*
     * 위원회 소개 글 — 소식 탭 위원회 카드 뒷면의 "목표"(2026-10-05 이전에는 하는 일 · 준비 중인 일 두 칸).
     * 원우 누구나 읽고 **누구나 고칩니다** (2026-09-24 사용자 "위원회 카드들 뒷면 수정할 수 있도록").
     * 위원회 일은 그 위원회 원우들이 직접 적는 것이 맞다는 판단입니다. 하루 전에는 운영진만 고칠 수 있었습니다.
     * (총괄 임원진 조직도는 앱 코드에 적혀 있어 아무도 앱에서 고칠 수 없습니다 — components/CommitteeOrgChart.tsx.)
     */
    /*
     * ★ 2026-10-06 사용자 요청 (보안 점검 후 수정): "누구나 고침"(사용자 결정)은 그대로 두고, 칸과 길이만 묶었습니다.
     *   고칠 수 있는 칸은 CommitteeRoster가 적는 goal·about·projects·updatedAt뿐, goal은 2000자까지.
     *   (엉뚱한 칸·아주 긴 글로 문서를 부풀리는 것을 막음.) 지우기는 운영진만(앱에는 지우는 곳이 없음).
     */
    match /committeeInfo/{committeeId} {
      allow read: if true;
      allow create, update: if isMember()
                            && request.resource.data.keys().hasOnly(['goal', 'about', 'projects', 'updatedAt'])
                            && request.resource.data.get('goal', '') is string
                            && request.resource.data.get('goal', '').size() <= 2000
                            && request.resource.data.get('about', '') is string
                            && request.resource.data.get('about', '').size() <= 2000
                            && request.resource.data.get('projects', '') is string
                            && request.resource.data.get('projects', '').size() <= 2000;
      allow delete: if isAdmin();
    }

    /*
     * 행사 사진 앨범(원우 소식 카드). ★ 2026-10-06 사용자 요청 (보안 점검 후 수정)으로 좁혔습니다.
     *   만들기: 원우, createdBy는 내 uid(남의 이름으로 올리기 불가), 사진 주소는 우리 Cloudinary 것.
     *   고치기·지우기: 올린 사람과 운영진. 단, 원우 누구나 할 수 있는 것이 둘 있습니다.
     *     ① ❤️ 공감 — likedBy에서 **내 uid만** 넣고 빼기(AlbumList togglePray).
     *     ② 앨범 화면에서 아무 원우나 사진을 더하고/자기 사진을 지우는 협업(album.tsx) 때문에 photoCount를
     *        한 번에 -1~+50 범위로, coverImageUrl은 아직 대표 사진이 없을 때 우리 Cloudinary 주소로만.
     *   ★ 남긴 한계: photoCount는 원우끼리 ±범위 안에서 어긋나게 만들 수 있습니다(표시용 숫자라 감수).
     */
    match /photoAlbums/{albumId} {
      allow read: if true;

      allow create: if isMember()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'title', 'eventDate', 'body', 'coverImageUrl', 'photoCount', 'cohort', 'weekId',
                         'createdBy', 'createdByName', 'createdAt', 'category', 'likedBy'])
                    && isCloudinaryUrl(request.resource.data.get('coverImageUrl', null));

      allow update: if isAdmin()
                    || (isMember()
                        && resource.data.get('createdBy', '') == request.auth.uid
                        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['title', 'eventDate', 'body', 'coverImageUrl', 'photoCount', 'likedBy']))
                    || (isMember()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
                        && request.resource.data.likedBy is list
                        && request.resource.data.likedBy.size() <= resource.data.get('likedBy', []).size() + 1
                        && request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet())
                             .hasOnly([request.auth.uid])
                        && resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet())
                             .hasOnly([request.auth.uid]))
                    || (isMember()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['photoCount', 'coverImageUrl'])
                        && request.resource.data.photoCount is int
                        && request.resource.data.photoCount >= 0
                        && request.resource.data.photoCount - resource.data.get('photoCount', 0) <= 50
                        && request.resource.data.photoCount - resource.data.get('photoCount', 0) >= -50
                        && (!('coverImageUrl' in request.resource.data.diff(resource.data).affectedKeys())
                            || (resource.data.get('coverImageUrl', null) == null
                                && isCloudinaryUrl(request.resource.data.coverImageUrl))));

      allow delete: if isAdmin()
                    || (isMember() && resource.data.get('createdBy', '') == request.auth.uid);

      /*
       * 앨범 안의 사진 한 장 한 장. 올리는 것은 원우 누구나(앨범 화면 "사진 더하기"가 열려 있는 협업 기능이라 그대로),
       * 단 uploadedBy는 내 uid이고 주소는 우리 Cloudinary 것. 지우기는 올린 사람·앨범 올린 사람·운영진.
       * 고치기는 캡션만(올린 사람·운영진).
       */
      match /photos/{photoId} {
        allow read: if true;
        allow create: if isMember()
                      && request.resource.data.uploadedBy == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                           'imageUrl', 'publicId', 'width', 'height', 'caption', 'uploadedBy',
                           'uploadedByNickname', 'uploadedAt', 'likes'])
                      && isCloudinaryUrl(request.resource.data.imageUrl);
        allow update: if isAdmin()
                      || (isMember()
                          && resource.data.get('uploadedBy', '') == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption']));
        allow delete: if isAdmin()
                      || (isMember()
                          && (resource.data.get('uploadedBy', '') == request.auth.uid
                              || get(/databases/$(database)/documents/photoAlbums/$(albumId))
                                   .data.get('createdBy', '') == request.auth.uid));
      }
    }

    /*
     * 홈 화면의 투표.
     *
     * **여는 것은 원우 누구나** 할 수 있습니다. 일정 등록과 달리 운영진으로
     * 좁히지 않았습니다 — 모임 날짜를 고르거나 안건에 찬반을 묻는 일은
     * 원우회 임원 누구에게나 생깁니다.
     *
     * 닫고 지우는 것은 연 사람과 운영진만. 남이 연 투표를 도중에 닫아버리면
     * 결과가 뒤집히기 때문입니다.
     */
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isMember()
                    && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isMember()
                    && (resource.data.createdBy == request.auth.uid || isAdmin());

      /*
       * 고칠 수 있는 것은 closed 하나뿐입니다.
       *
       * 표가 들어온 뒤에 물음이나 고를 것을 바꾸면, 사람들이 실제로 무엇에
       * 답했는지 알 수 없게 됩니다. 그건 결과를 조용히 조작하는 것과 같아서
       * 아예 막습니다. 물음을 잘못 적었으면 지우고 새로 엽니다.
       */
      allow update: if isMember()
                    && (resource.data.createdBy == request.auth.uid || isAdmin())
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['closed']);

      /*
       * ★★ 무기명 투표 (2026-09-11) — 누가 무엇을 골랐는지 어디에도 남지 않습니다.
       *
       *   tally/counts  : 자리마다 표 수만. 원우 누구나 읽습니다.
       *   voters/{uid}  : "이 사람은 이미 넣었다"는 표시만(무엇을 골랐는지 없음). 본인만 읽습니다.
       *
       * 표 한 장 = 한 쓰기(트랜잭션)에서 voters/{내 uid}를 새로 만들고 tally의 한 자리를 +1.
       * 두 문서의 규칙이 서로를 확인합니다(existsAfter·getAfter).
       *  - voters는 만들기만 되고 고치기·지우기가 없습니다 → 한 사람 한 표, 다시 고르기 없음.
       *  - tally는 "내 voters 표시가 이번 쓰기에서 처음 생길 때"만, 한 자리만 정확히 1 늘 수 있습니다.
       *  - 닫힌 투표에는 넣을 수 없습니다.
       * 서버 어디에도 uid와 고른 자리가 함께 적히지 않으므로, 운영진이 콘솔을 열어도 이을 수 없습니다.
       *
       * 예전의 votes/{uid}(고른 자리 + uid, 원우 누구나 읽음)는 없앴고 규칙에서도 뺐습니다.
       * 규칙에 없는 하위 컬렉션은 앱에서 읽지도 쓰지도 못합니다.
       */
      /*
       * ★ 지우기를 따로 적어야 합니다.
       *
       *   예전에는 write 하나로 묶고 `request.method == 'delete'`로 갈랐는데,
       *   **Firestore 규칙에는 request.method라는 것이 없습니다.** 그러면 파일
       *   전체가 문법 오류가 되어 콘솔이 게시를 거부하고, 옛 규칙이 그대로
       *   남습니다. 파일만 고치고 게시가 안 된 줄 모르면 "규칙은 올렸는데
       *   권한 오류가 난다"가 됩니다. (2026-09-09에 실제로 그랬습니다.)
       *
       *   지우기에는 request.resource가 없습니다(없앨 문서라 새 내용이 없음).
       *   그래서 create·update와 조건이 다를 수밖에 없고, 나눠 적는 것이
       *   원래 맞는 방식입니다.
       */
      match /tally/{docId} {
        allow read: if true;
        // 투표를 여는 그 쓰기(묶음)에서, 연 사람이 고를 것 수만큼의 0으로 만듭니다.
        allow create: if isMember()
                      && docId == 'counts'
                      && getAfter(/databases/$(database)/documents/polls/$(pollId)).data.createdBy
                           == request.auth.uid
                      && request.resource.data.keys().hasOnly(['counts'])
                      && request.resource.data.counts.size()
                           == getAfter(/databases/$(database)/documents/polls/$(pollId)).data.options.size()
                      && isAllZero(request.resource.data.counts);
        // 표를 넣는 그 쓰기에서만 — 내 voters 표시가 이번에 처음 생기고, 한 자리만 +1.
        allow update: if isMember()
                      && docId == 'counts'
                      && get(/databases/$(database)/documents/polls/$(pollId)).data.closed == false
                      && !exists(/databases/$(database)/documents/polls/$(pollId)/voters/$(request.auth.uid))
                      && existsAfter(/databases/$(database)/documents/polls/$(pollId)/voters/$(request.auth.uid))
                      && request.resource.data.keys().hasOnly(['counts'])
                      && isOneVoteMore(resource.data.counts, request.resource.data.counts);
        allow delete: if false;
      }

      match /voters/{uid} {
        // 내가 넣었는지만 봅니다. 목록 훑기는 아무에게도 열지 않습니다(누가 넣었는지도 드러내지 않게).
        allow get: if isMember() && request.auth.uid == uid;
        allow list: if false;
        // 표 수가 같은 쓰기에서 바뀌어야 만들 수 있습니다(바뀌는 방식은 위 tally update가 확인).
        allow create: if isMember()
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['votedAt'])
                      && get(/databases/$(database)/documents/polls/$(pollId)).data.closed == false
                      && getAfter(/databases/$(database)/documents/polls/$(pollId)/tally/counts).data.counts
                           != get(/databases/$(database)/documents/polls/$(pollId)/tally/counts).data.counts;
        allow update, delete: if false;
      }

      /*
       * 익명 의견 — 표와 정반대로 설계했습니다.
       *
       * ★★ hasOnly(['text','createdAt'])가 이 기능의 핵심입니다.
       *   이 한 줄이 **uid나 이름을 끼워 넣는 쓰기를 거절**합니다. 그래서
       *   익명이 "그렇게 하기로 했다"는 약속이 아니라, 앱을 고쳐도 뚫을 수
       *   없는 구조가 됩니다. 문서 id도 자동 생성이라(앱에서 addDoc) 목록을
       *   훑어도 사람을 되짚을 수 없습니다.
       *   이 줄을 지우면 익명은 그 순간 사라집니다.
       *
       * 고치기는 막습니다. 익명 글이 조용히 바뀌면 누가 무슨 말을 했는지
       * 아무도 확인할 수 없습니다.
       *
       * 지우기는 의견을 모은 사람과 운영진만. 본인 것만 지우는 길은 만들 수
       * 없습니다 — 누가 썼는지 아무 데도 안 적혀 있기 때문입니다.
       */
      match /opinions/{opinionId} {
        allow read: if true;
        allow create: if isMember()
                      && request.resource.data.keys().hasOnly(['text', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0;
        allow update: if false;
        allow delete: if isMember()
                      && (isAdmin()
                          || get(/databases/$(database)/documents/polls/$(pollId))
                               .data.createdBy == request.auth.uid);
      }
    }

    /*
     * 자료 탭에 올리는 문서 파일 (PDF·한글·엑셀 등).
     *
     * 올리는 것은 원우 누구나. 지우는 것과 이름을 바꾸는 것은
     * **올린 본인과 운영진만** 됩니다.
     * 사진·수첩과 달리 여기만 좁힌 이유는, 남이 올린 자료가 조용히 사라지면
     * 되돌릴 길이 없어서입니다 (Cloudinary의 실물까지는 앱이 못 지우고 문서만
     * 사라지므로, 목록에서 없어지면 아무도 다시 찾지 못합니다).
     */
    match /files/{fileId} {
      // 보는 것도 원우만 (2026-09-25 사용자 "파일창도 로그인해야만") — 2026-09-24 둘러보기 때 true로 열었던 것을 되돌림.
      allow read: if isMember();
      // ★ 2026-10-06 사용자 요청 (보안 점검 후 수정): 칸을 library/page.tsx가 적는 것으로 묶고, 주소는 우리 Cloudinary https 주소만.
      allow create: if isMember()
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'name', 'url', 'publicId', 'format', 'bytes', 'cohort',
                         'uploadedBy', 'uploadedByName', 'uploadedAt'])
                    && isCloudinaryUrl(request.resource.data.get('url', null));
      allow delete: if isMember()
                    && (resource.data.uploadedBy == request.auth.uid || isAdmin());

      /*
       * 고칠 수 있는 것은 **이름 하나뿐**입니다.
       *
       * hasOnly로 못 박지 않으면 url·uploadedBy를 갈아끼워, 남이 올린 것처럼
       * 보이는 자리에 엉뚱한 파일을 걸어둘 수 있습니다. 파일을 바꾸려면
       * 새로 올리고 옛것을 지웁니다.
       */
      allow update: if isMember()
                    && (resource.data.uploadedBy == request.auth.uid || isAdmin())
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
    }

    /*
     * memberRegions — 원우 지도(시·도만 저장)가 있던 자리입니다. 2026-09-11에 기능을 없애며
     * 규칙도 지웠습니다. 규칙에 없는 컬렉션은 앱에서 읽지도 쓰지도 못합니다.
     * 남아 있는 문서는 Firestore 콘솔에서 지우면 됩니다.
     */

    // 주차별 수업의 주제·강사·영상. 원우수첩처럼 누구나 채웁니다.
    match /sessions/{week} {
      allow read: if true;
      // ★ 2026-10-06 사용자 요청 (보안 점검 후 수정): 앱 어디에도 이 문서를 쓰는 화면이 없습니다(읽기만, lib/hooks.ts).
      //   주제·강사·영상은 운영진이 콘솔·스크립트로 채우므로, 쓰기는 운영진으로 좁혔습니다(원우가 수업 정보를 바꾸지 못하게).
      allow write: if isAdmin();

      /*
       * 그 주 수업에 남기는 느낀점 댓글. 모든 원우가 서로 읽습니다.
       *
       * 남의 이름으로 쓰지 못하도록 쓴 사람이 본인인지 확인하고,
       * 지우는 것도 자기 글만 됩니다. 고치기는 막아 두었습니다 —
       * 오간 이야기가 나중에 조용히 바뀌면 대화가 남지 않습니다.
       */
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isMember()
                      && request.resource.data.authorId == request.auth.uid;
        allow delete: if isMember() && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }
    }

    /*
     * sessionNotes — 본인만 보던 주차별 느낀점이 있던 자리입니다.
     * 서로 나누자는 취지로 위 comments로 바뀌면서 앱에서 더는 읽지 않습니다.
     * 예전에 적어둔 글은 Firestore 콘솔에 그대로 남아 있습니다.
     */

    // ── 채팅 ──
    // 방은 두 종류입니다 (2026-09-22).
    //   1:1 방(uid__uid)       그 두 사람만.
    //   기수 단체방(cohort-10)  그 기수 원우 전원 + 운영진. 자격은 users의 cohort로 가립니다(canUseRoom).

    match /chatRooms/{roomId} {
      /*
       * 방 하나를 직접 열 때(get) — 방 id로 판단합니다.
       */
      allow get: if isMember() && canUseRoom(roomId);

      /*
       * 채팅 목록처럼 여러 방을 한꺼번에 훑을 때(list) — 여기가 까다롭습니다.
       *
       * Firestore는 목록 조회를 "문서 id"로는 검증하지 못합니다.
       * 질의를 보낼 때는 어떤 문서가 나올지 아직 모르니, 문서 id를 보는
       * 규칙으로는 안전하다고 증명할 수 없어 통째로 거부해 버립니다.
       * (규칙은 걸러주는 체가 아니라 통과·거부를 정하는 문지기입니다.)
       *
       * 그래서 목록만은 문서 안의 memberUids를 봅니다. 앱이 거는 질의가
       *   where("memberUids", "array-contains", 내 uid)
       * 라서, 나온 문서는 반드시 내가 낀 방임이 질의 자체로 보장됩니다.
       * 이 짝이 맞아야 통과하므로 앱의 질의를 바꾸면 여기도 같이 고쳐야 합니다.
       */
      allow list: if isMember() && request.auth.uid in resource.data.memberUids;

      /*
       * 방을 만들거나 마지막 메시지를 갱신하는 것은 방 id로 막습니다.
       * memberUids로 막으면, 남이 쓸 방 id를 먼저 선점해 자기 이름만 넣어
       * 만들어두는 장난이 가능해집니다. 방 id는 두 사람의 uid로 이미
       * 정해져 있으므로 선점 자체가 불가능합니다.
       */
      /*
       * ★ 2026-10-06 사용자 요청 (보안 점검 후 수정): 방 문서에 쓸 수 있는 칸·모양을 묶었습니다.
       *   - 칸: kind·title·cohort·memberUids·lastMessageText·lastMessageSenderId·lastMessageAt뿐(lib/chat-rooms.ts가 적는 것).
       *   - 1:1 방(uid__uid): memberUids가 있다면 **방 id의 두 uid와 정확히 같아야** 합니다(남을 끼워 넣거나 빼는 장난 불가).
       *   - 기수 단체방: memberUids를 두지 않고, cohort는 방 id의 기수와 같아야 합니다.
       *   - 방 지우기는 없앴습니다(앱에 지우는 곳이 없음 — 예전엔 방 안 사람 누구나 문서를 지울 수 있었음).
       *   바뀐 칸만 보는(affectedKeys) 이유: 옛 방 문서에 남은 낡은 칸 때문에 메시지를 못 보내는 일이 없게.
       */
      allow create: if isMember()
                    && canUseRoom(roomId)
                    && request.resource.data.keys().hasOnly(['kind', 'title', 'cohort', 'memberUids',
                         'lastMessageText', 'lastMessageSenderId', 'lastMessageAt'])
                    && chatRoomShapeOk(roomId);
      allow update: if isMember()
                    && canUseRoom(roomId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'title', 'cohort',
                         'memberUids', 'lastMessageText', 'lastMessageSenderId', 'lastMessageAt'])
                    && chatRoomShapeOk(roomId);

      match /messages/{messageId} {
        allow read: if isMember() && canUseRoom(roomId);

        // 남의 이름으로 보내지 못하도록 보내는 사람이 본인인지 확인합니다.
        allow create: if isMember()
                      && canUseRoom(roomId)
                      && request.resource.data.senderId == request.auth.uid;

        /*
         * 지우기는 본인 것만. 남의 말은 운영진도 지울 수 없습니다.
         *
         * resource.data는 "지금 저장돼 있는 문서"라, 여기서 senderId를 보는 것은
         * 곧 보낸 사람 본인인지 확인하는 것입니다. 방 안에 있다는 것만으로는
         * 모자랍니다 — 그러면 1:1 상대가 내 말을 지울 수 있습니다.
         */
        allow delete: if isMember()
                      && canUseRoom(roomId)
                      && resource.data.senderId == request.auth.uid;

        /*
         * 고치기도 본인 것만. 다만 지우기보다 조건이 깁니다.
         *
         * 고치기는 "하지도 않은 말을 한 것처럼" 만들 수 있어서, 아무 칸이나
         * 열어주면 안 됩니다. 세 가지를 못 박습니다.
         *  1) hasOnly — 바꿀 수 있는 칸은 text와 editedAt **둘뿐**입니다.
         *     senderId를 바꿔 남이 한 말로 떠넘기거나, createdAt을 당겨
         *     대화 순서를 뒤집는 길이 여기서 막힙니다.
         *  2) editedAt이 반드시 들어와야 합니다 — 고친 흔적을 지운 채로는
         *     못 고칩니다. 화면의 "수정됨" 표시가 이 값에서 나옵니다.
         *  3) text는 비어 있으면 안 됩니다. 빈 말풍선은 지운 것과 같은데,
         *     지우기는 지우기로 해야 목록 미리보기까지 제대로 정리됩니다.
         */
        allow update: if isMember()
                      && canUseRoom(roomId)
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['text', 'editedAt'])
                      && request.resource.data.editedAt == request.time
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0;
      }
    }

    // 내가 각 방을 마지막으로 본 시각(+ 알림함을 마지막으로 연 시각). 남의 것은 보지도 고치지도 못합니다.
    match /chatReads/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    /*
     * 방마다 알림을 끈 원우 (2026-09-27) — 문서 id는 방 id, 칸은 {uid: true}.
     * 알림 서버(/api/push/chat, Admin SDK)만 읽습니다. 앱은 읽지 못합니다 — 누가 알림을 껐는지 남이 볼 까닭이 없습니다.
     * 쓰기는 그 방을 쓸 수 있는 원우가 **자기 uid 칸 하나만** 넣고 뺄 수 있습니다(lib/chat-prefs.ts).
     */
    match /chatMutes/{roomId} {
      allow read: if false;
      allow create: if isMember()
                    && canUseRoom(roomId)
                    && request.resource.data.keys().hasOnly([request.auth.uid]);
      allow update: if isMember()
                    && canUseRoom(roomId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
    }

    /*
     * 헤더 알림함(종)에 쌓이는 알림 (2026-09-11) — 새 일정, 새 복습 영상·소식.
     * 서버(Admin SDK)만 적습니다: /api/push/event, Netlify 예약 함수 feed-push. 앱에서는 읽기만 합니다.
     * 사람마다 따로 적지 않고 한 건씩이라, 앱이 내 기수 것과 "all"만 골라 보여줍니다.
     */
    match /notices/{noticeId} {
      allow read: if isMember();
      allow write: if false;
    }

    /*
     * 이번주 원우 소식 단톡방용 카톡 초안 (2026-09-24) — 운영진 화면 "원우 소식" 탭.
     * 서버(/api/news/weekly-close, 매주 월요일 18시 GitHub Actions가 부름)만 적고, 운영진만 읽습니다.
     */
    match /weeklyDrafts/{weekId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /*
     * 웹 푸시 알림을 받을 기기 목록. 문서 id가 곧 FCM 등록 토큰입니다.
     *
     * 여기는 **원우끼리 열어두면 안 되는 자리**입니다. 목록을 훑을 수 있으면
     * 누가 어떤 기기를 쓰는지 다 보이고, 남의 토큰을 지워 알림을 끊을 수도
     * 있습니다. 그래서 자기 기기 하나만 만들고·고치고·지울 수 있게 합니다.
     *
     * 훑기(list)는 아무에게도 열지 않습니다. 발송할 때 받는 사람들의 토큰을
     * 모으는 일은 서버(Admin SDK)가 하는데, Admin SDK는 이 규칙을 건너뜁니다.
     */
    match /pushTokens/{token} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if isMember()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    /*
     * 내가 차단한 사람 목록 (사용자 요청 2026-10-06, 구글 플레이 출시 준비) — 본인만 읽고 씁니다.
     * 차단은 내 화면에서만 상대 글을 감춥니다. 문서 모양: { blocked: { 상대uid: true } }
     */
    match /userBlocks/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    /*
     * 신고 (사용자 요청 2026-10-06, 구글 플레이 출시 준비) — 원우는 올리기만(자기 이름으로, 정해진 칸만, 열림 상태로),
     * 읽고 고치는 것은 운영진만. 지우기는 아무도 못 합니다(처리는 서버 /api/report/resolve가 상태만 바꿈, 탈퇴 정리는 Admin SDK).
     */
    match /reports/{reportId} {
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(['reporterUid', 'reporterName', 'targetType', 'targetPath', 'targetUid',
                                                             'targetName', 'preview', 'cohort', 'reason', 'detail', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(['reporterUid', 'targetType', 'targetPath', 'targetUid', 'targetName',
                                                            'preview', 'cohort', 'reason', 'status', 'createdAt'])
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.status == 'open'
                    && request.resource.data.targetType in ['message', 'album', 'file', 'opinion', 'poll', 'comment', 'video', 'user']
                    && request.resource.data.targetPath is string && request.resource.data.targetPath.size() <= 200
                    && request.resource.data.targetUid is string && request.resource.data.targetUid.size() <= 128
                    && request.resource.data.targetName is string && request.resource.data.targetName.size() <= 100
                    && request.resource.data.preview is string && request.resource.data.preview.size() <= 140
                    && request.resource.data.cohort is string && request.resource.data.cohort.size() <= 20
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
                    && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 300;
      allow read, update: if isAdmin();
    }

    /*
     * pushLog — "이 일정 알림은 이미 보냈다"는 표시만 남기는 자리입니다.
     * 일부러 규칙을 적지 않았습니다. 서버(Admin SDK)만 쓰는 곳이고,
     * Admin SDK는 규칙을 건너뛰기 때문입니다. 규칙에 없는 컬렉션은
     * 클라이언트에게 닫혀 있으므로, 적지 않은 것이 곧 "아무도 못 봄"입니다.
     */
  }
}
