rules_version = '2';

/*
 * 애기애타 10기 앱 Firestore 보안 규칙 — 열어둔 상태
 * ------------------------------------------------------------------
 * Google 계정으로 로그인한 사람은 누구나 모든 자료를 읽고 쓸 수 있습니다.
 * 원우들 사이에 권한 차이가 없고, 운영진 승인도 거치지 않습니다.
 *
 * 이렇게 두기로 한 이유:
 *   원우들이 가입 직후 프로필을 채우지 못하고 로딩 화면만 도는 문제가 있었고,
 *   기수 안에서 서로 정보를 채워주는 수첩이라 권한을 나눌 실익이 적었습니다.
 *
 * 대신 이 점을 알고 계셔야 합니다:
 *   - 주소를 아는 사람은 Google 계정만 있으면 누구나 들어와 볼 수 있습니다.
 *     (원우들의 휴대폰 번호를 포함해서요)
 *   - 들어온 사람은 남의 정보를 고치거나 지울 수도 있습니다.
 *   - 잘못 들어온 사람을 막는 방법은 지금 없습니다.
 *
 * 다시 잠그고 싶어지면 git 이력에서 이 파일의 이전 판을 가져오면 됩니다.
 * (승인 상태·운영진 권한·본인만 수정 같은 장치가 모두 들어 있습니다.)
 *
 * 배포:  Firebase 콘솔 → Firestore → 규칙 탭에 붙여넣고 "게시"
 *        또는  firebase deploy --only firestore:rules
 *
 * ★ 이 파일을 고치는 것만으로는 아무것도 바뀌지 않습니다.
 *   반드시 콘솔에 올려야(게시해야) 실제로 적용됩니다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
