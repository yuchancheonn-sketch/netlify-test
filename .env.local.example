# ------------------------------------------------------------------
# 이 파일을 복사해서 `.env.local` 로 이름을 바꾸고 값을 채워 주세요.
#
#   Firebase 콘솔 → 프로젝트 설정(톱니바퀴) → 일반 →
#   "내 앱" 에서 웹 앱(</>) 을 추가하면 아래 값들이 한 번에 나옵니다.
#
# NEXT_PUBLIC_ 으로 시작하는 값은 브라우저에 그대로 노출됩니다.
# Firebase 웹 설정값은 원래 공개되는 값이라 문제되지 않습니다.
# 진짜 접근 제어는 firestore.rules / storage.rules 가 담당합니다.
# ------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# 행사 사진 보관소 (Cloudinary) — 카드 등록 없이 무료 25GB
#
#   cloudinary.com 가입 → Dashboard 에서 Cloud name 확인
#   Settings → Upload → Upload presets → Add upload preset
#     - Signing Mode: Unsigned   (반드시 Unsigned 여야 브라우저에서 바로 올릴 수 있습니다)
#     - Asset folder: aegiaeta10
#   만들어진 preset 이름을 아래에 넣으세요.
#
# 이 두 값을 비워두면 사진 탭에서 "설정이 안 되어 있어요" 안내가 뜹니다.
# ------------------------------------------------------------------

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------------------------
# 복습 영상 — 도산아카데미 유튜브 채널(@dosanacademy)
#
# 비워두어도 됩니다. 비워두면 누구나 열 수 있는 채널 RSS로
# "최근 15편"이 보이고, 열쇠를 넣으면 "채널의 모든 영상"이 보입니다.
#
#   Google Cloud 콘솔(Firebase와 같은 프로젝트를 써도 됩니다)
#   → API 및 서비스 → 라이브러리 → "YouTube Data API v3" 사용 설정
#   → 사용자 인증 정보 → API 키 만들기 → 아래에 붙여넣기
#   → Netlify 사이트 설정의 환경변수에도 같은 값을 넣고 다시 배포
#
# NEXT_PUBLIC_ 이 붙지 않았으므로 이 값은 서버에만 남고
# 브라우저로는 나가지 않습니다. (키 제한은 "API 제한 → YouTube Data API v3" 권장)
# ------------------------------------------------------------------

YOUTUBE_API_KEY=

# ------------------------------------------------------------------
# 웹 푸시 알림 (FCM) — 새 채팅이 오면 폰에 알림이 뜹니다
#
# 두 값이 모두 있어야 알림이 동작합니다. 비워두면 설정 화면의 "알림"이
# "아직 준비되지 않았어요"로 표시되고, 앱의 나머지는 그대로 돌아갑니다.
#
# ① 웹 푸시 인증서 (브라우저에 노출되는 공개키 — 새는 값이 아닙니다)
#    Firebase 콘솔 → 프로젝트 설정(톱니바퀴) → 클라우드 메시징
#    → "웹 푸시 인증서" → 키 쌍 생성 → 나온 키를 아래에 붙여넣기
#
# ② 서비스 계정 (★진짜 비밀값★ — 절대 커밋하거나 남에게 보내지 마세요)
#    Firebase 콘솔 → 프로젝트 설정 → 서비스 계정
#    → "새 비공개 키 생성" → 내려받은 JSON 파일을 열어
#    → **한 줄로 만들어** 통째로 아래에 붙여넣기 (따옴표 없이)
#    예: FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":...}
#
#    NEXT_PUBLIC_ 이 없으므로 이 값은 서버에만 남고 브라우저로 나가지 않습니다.
#    Netlify 환경변수에도 같은 두 값을 넣고 다시 배포해야 배포본에서 동작합니다.
# ------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT=
